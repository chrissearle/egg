# The build context needs exactly three things: server/ to compile, build/web
# for the exported game, and assets/generated for the pages' art. Everything
# else is either large or irrelevant, and context is uploaded before the build
# can start.

.git
.github
.claude
.playwright-mcp

# Godot's import cache — regenerated, and bigger than anything it would help.
.godot

# The Godot project itself. The engine has already turned all of this into
# build/web by the time an image is built.
scenes
scripts
levels
tools
assets/Sprites
project.godot
export_presets.cfg
icon.svg
icon.svg.import

# Gradle output from a local build. The image compiles from source in its own
# stage, and copying a host build in would land the wrong architecture.
server/build
server/.gradle

docs
*.md
LICENSE
mise.toml
.editorconfig
.gitattributes
.DS_Store
